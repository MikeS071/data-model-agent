{
  "delivery": {
    "schemaVersion": 1,
    "project": {
      "schemaVersion": 1,
      "repository": "MikeS071/data-model-agent",
      "branchPrefixes": ["feature", "fix", "chore"]
    },
    "baseBranch": "main",
    "queue": null,
    "instructionPaths": [
      "AGENTS.md",
      ".governance/policy.md",
      ".governance/quality.md",
      ".governance/principles.md"
    ],
    "templates": {
      "issue": ".governance/templates/issue.md",
      "pr": ".governance/templates/pr.md"
    }
  },
  "verification": {
    "schemaVersion": 1,
    "commands": {
      "typecheck": ["pnpm", "--dir", "apps/web", "exec", "tsc", "--noEmit"],
      "unit": ["pnpm", "--dir", "apps/web", "test"],
      "build": ["pnpm", "--dir", "apps/web", "build"],
      "browser": ["pnpm", "--dir", "apps/web", "test:e2e"]
    }
  }
}
